{
  "name": "sufigarden-redesign",
  "version": "1.0.0",
  "description": "Premium Redesign of the Sufi Garden Website",
  "private": true,
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run start:dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "test:backend": "npm run test --prefix backend",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "prisma": "^6.0.0"
  }
}

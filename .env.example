# ==============================================================================
# SUFI GARDEN — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Connection URL (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>?schema=public
DATABASE_URL="postgresql://sufi_admin:YOUR_SECURE_PASSWORD@localhost:5432/sufigarden_db?schema=public"

# NestJS Backend API Server Port
PORT=3001

# JWT Secret Key for Administrator Signatures (MUST be a long, randomly generated string in production)
JWT_SECRET="generate_a_64_character_random_secret_string_here_for_production"

# Allowed CORS Origins (comma-separated list for production domains)
ALLOWED_ORIGINS="https://sufigarden.org,https://www.sufigarden.org"

# Frontend Public API URL (Accessible from client-side browsers)
NEXT_PUBLIC_API_URL="https://api.sufigarden.org"
